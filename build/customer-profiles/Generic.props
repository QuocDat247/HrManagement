<Project>

  <PropertyGroup>

    <HrProductEdition>Standard</HrProductEdition>
    <HrCustomerCode>Generic</HrCustomerCode>
    <HrReleaseChannel>Production</HrReleaseChannel>

    <HrBrandProductDisplayName>HR Management</HrBrandProductDisplayName>
    <HrBrandCustomerDisplayName>Bản tiêu chuẩn</HrBrandCustomerDisplayName>
    <HrBrandSupportLabel>Hỗ trợ kỹ thuật</HrBrandSupportLabel>
    <HrBrandSupportContact>Liên hệ nhà cung cấp triển khai</HrBrandSupportContact>

    <HrFeatureEmployees>true</HrFeatureEmployees>
    <HrFeatureOrganization>true</HrFeatureOrganization>
    <HrFeatureTimeManagement>true</HrFeatureTimeManagement>
    <HrFeaturePayroll>true</HrFeaturePayroll>

  </PropertyGroup>

</Project>
