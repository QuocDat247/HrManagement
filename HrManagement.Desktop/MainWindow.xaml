<Window x:Class="HrManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HrManagement.Desktop.ViewModels"
        xmlns:views="clr-namespace:HrManagement.Desktop.Views"
        Title="Quản trị nhân sự"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView/>
        </DataTemplate>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#20252B">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="HR MANAGEMENT"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="20,24"/>

                <StackPanel Margin="10">

                    <ItemsControl ItemsSource="{Binding NavigationItems}"
              Margin="10,10">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button Content="{Binding Title}"
                    Height="42"
                    Margin="0,3"
                    HorizontalContentAlignment="Left"
                    Padding="12,0"
                    Command="{Binding DataContext.NavigateCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1"
              Background="#F5F6F8">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SelectedNavigationItem.Title}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="admin"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <!-- Navigation content -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="24"/>

        </Grid>

    </Grid>

</Window>