<Window x:Class="HrManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản trị nhân sự"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#20252B">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="HR MANAGEMENT"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="20,24"/>

                <StackPanel Margin="10,10">

                    <Button Content="Tổng quan"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Tổng quan"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Nhân viên"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Nhân viên"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Phòng ban"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Phòng ban"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Hợp đồng"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Hợp đồng"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Chấm công"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Chấm công"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Nghỉ phép"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Nghỉ phép"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Tiền lương"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Tiền lương"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Báo cáo"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Báo cáo"
                            Margin="0,3"
                            Height="42"/>

                    <Button Content="Hệ thống"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Hệ thống"
                            Margin="0,3"
                            Height="42"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              Background="#F5F6F8">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="admin"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>

            <!-- Content -->
            <Grid Grid.Row="1"
                  Margin="24">

                <Border Background="White"
                        Padding="30"
                        CornerRadius="8">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding CurrentPageTitle}"
                            FontSize="32"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="Nội dung module sẽ được xây dựng ở bước tiếp theo."
                            Margin="0,12,0,0"
                            FontSize="15"
                            Foreground="Gray"
                            HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>