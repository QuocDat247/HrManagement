<Window x:Class="HrManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HrManagement.Desktop.ViewModels"
        xmlns:views="clr-namespace:HrManagement.Desktop.Views"
        xmlns:converters="clr-namespace:HrManagement.Desktop.Converters"
        xmlns:navigation="clr-namespace:HrManagement.Desktop.Navigation"
        Title="Quản trị nhân sự"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <converters:EqualityConverter
            x:Key="EqualityConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DepartmentsViewModel}">
            <views:DepartmentsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PositionsViewModel}">
            <views:PositionsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WorkScheduleWorkspaceViewModel}">
            <views:WorkScheduleWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HolidayExceptionWorkspaceViewModel}">
            <views:HolidayExceptionWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MonthlyTimesheetWorkspaceViewModel}">
            <views:MonthlyTimesheetWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OvertimeWorkspaceViewModel}">
            <views:OvertimeWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PayrollWorkspaceViewModel}">
            <views:PayrollWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AttendanceLeaveWorkspaceViewModel}">
            <views:AttendanceLeaveWorkspaceView />
        </DataTemplate>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="HR MANAGEMENT"
                           Foreground="{DynamicResource SidebarTextBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="20,24"/>

                <StackPanel Margin="10">

                    <ItemsControl ItemsSource="{Binding NavigationItems}"
                        Margin="10,10">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Button Content="{Binding Title}"
                                        Style="{DynamicResource SidebarNavigationButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">

                                    <navigation:NavigationState.IsActive>

                                        <MultiBinding Converter="{StaticResource EqualityConverter}">

                                            <Binding />

                                            <Binding Path="DataContext.SelectedNavigationItem"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />

                                        </MultiBinding>

                                    </navigation:NavigationState.IsActive>

                                </Button>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1"
              Background="{DynamicResource PageBackgroundBrush}">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{DynamicResource HeaderBorderStyle}">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SelectedNavigationItem.Title}"
                               Style="{DynamicResource PageTitleTextStyle}" />

                    <Border Grid.Column="1"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <TextBlock Text="{Binding CurrentUserDisplayName}"
                           Style="{DynamicResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />

                    </Border>

                </Grid>

            </Border>

            <!-- Navigation content -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="24"/>

        </Grid>

    </Grid>

</Window>
