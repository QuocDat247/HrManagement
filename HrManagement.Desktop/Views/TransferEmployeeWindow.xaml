<Window x:Class="HrManagement.Desktop.Views.TransferEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều chuyển nhân viên"
        Width="520"
        Height="560"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Điều chuyển nhân viên"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Margin="0,6,0,0"
                       Text="{Binding EmployeeDisplayName}"
                       FontSize="15"
                       FontWeight="SemiBold" />

        </StackPanel>

        <!-- Current organization -->
        <Border Grid.Row="1"
                Margin="0,0,0,18"
                Padding="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">

            <StackPanel>

                <TextBlock Text="Phân công hiện tại"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBlock>
                    <Run Text="Phòng ban: " />
                    <Run Text="{Binding CurrentDepartmentName}"
                         FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Margin="0,5,0,0">
                    <Run Text="Chức danh: " />
                    <Run Text="{Binding CurrentPositionName}"
                         FontWeight="SemiBold" />
                </TextBlock>

            </StackPanel>

        </Border>

        <!-- Department -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,14">

            <TextBlock Text="Phòng ban mới"
                       Margin="0,0,0,6" />

            <ComboBox MinHeight="36"
                      ItemsSource="{Binding DepartmentOptions}"
                      SelectedItem="{Binding SelectedDepartment,
                                             Mode=TwoWay}"
                      DisplayMemberPath="Name" />

        </StackPanel>

        <!-- Position -->
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,14">

            <TextBlock Text="Chức danh mới"
                       Margin="0,0,0,6" />

            <ComboBox MinHeight="36"
                      ItemsSource="{Binding PositionOptions}"
                      SelectedItem="{Binding SelectedPosition,
                                             Mode=TwoWay}"
                      DisplayMemberPath="Name" />

        </StackPanel>

        <!-- Effective date -->
        <StackPanel Grid.Row="4"
                    Margin="0,0,0,14">

            <TextBlock Text="Ngày hiệu lực"
                       Margin="0,0,0,6" />

            <DatePicker SelectedDate="{Binding EffectiveDate,
                                              Mode=TwoWay}"
                        SelectedDateFormat="Short"
                        MinHeight="36" />

            <TextBlock Margin="0,6,0,0"
                       Text="Phân công hiện tại sẽ kết thúc vào ngày trước ngày hiệu lực."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

        </StackPanel>

        <!-- Error -->
        <TextBlock Grid.Row="6"
                   Margin="0,12,0,12"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" />

        <!-- Actions -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Hủy"
                    Width="90"
                    MinHeight="36"
                    Margin="0,0,10,0"
                    IsCancel="True" />

            <Button Content="Điều chuyển"
                    Width="120"
                    MinHeight="36"
                    Command="{Binding SaveCommand}" />

        </StackPanel>

    </Grid>
</Window>
