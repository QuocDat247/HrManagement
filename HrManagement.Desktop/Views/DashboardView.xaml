<UserControl x:Class="HrManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HrManagement.Desktop.Converters"
             Loaded="DashboardView_Loaded"
             Unloaded="DashboardView_Unloaded">

    <UserControl.Resources>
        <converters:WorkforceBarHeightConverter
        x:Key="WorkforceBarHeightConverter" />
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tổng quan"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="Tình hình nhân sự hiện tại"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1"
            MinWidth="270"
            Padding="16,12"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Ngày -->
                            <StackPanel Margin="0,0,16,0"
                        VerticalAlignment="Center">

                                <TextBlock x:Name="CurrentDayText"
                           Text="12"
                           HorizontalAlignment="Center"
                           FontSize="32"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock x:Name="CurrentMonthYearText"
                           Text="Tháng 8, 2026"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                            </StackPanel>

                            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource BorderBrush}" />

                            <!-- Thứ + giờ -->
                            <StackPanel Grid.Column="2"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">

                                <TextBlock x:Name="CurrentWeekdayText"
                           Text="Thứ Tư"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock x:Name="CurrentDateText"
                           Text="12/08/2026"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock x:Name="CurrentTimeText"
                           Text="10:16:00"
                           Margin="0,6,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                            </StackPanel>

                        </Grid>

                    </Border>
                </Grid>

                <!-- KPI cards -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Employees -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Tổng nhân viên"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding TotalEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Active Employees -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang làm việc"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding ActiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Employees On Leave -->
                <Border Grid.Column="4"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang nghỉ"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding EmployeesOnLeave}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Contracts Expiring -->
                <Border Grid.Column="6"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Ngừng hoạt động"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding InactiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                

            </Grid>

            
            

        </Grid>
            <Border Margin="0,24,0,0"
        Padding="20"
        Background="{DynamicResource CardBackgroundBrush}"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="Chất lượng hồ sơ nhân viên"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,8,0,0"
                       Text="Email, số điện thoại và ngày sinh giúp hồ sơ nhân viên đầy đủ hơn."
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Margin="0,8,0,0"
                       Text="Tất cả hồ sơ đang hoạt động hiện đã có đủ thông tin cơ bản."
                       Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeesMissingProfileInformation}"
                                         Value="0">
                                            <Setter Property="Visibility"
                                        Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,8,0,0"
                       Text="Có hồ sơ nhân viên cần được bổ sung thông tin."
                       Foreground="{DynamicResource SecondaryTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeesMissingProfileInformation}"
                                         Value="0">
                                            <Setter Property="Visibility"
                                        Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                    Margin="24,0,0,0"
                    VerticalAlignment="Center">

                        <TextBlock Text="{Binding EmployeesMissingProfileInformation}"
                       HorizontalAlignment="Center"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Text="hồ sơ cần bổ sung"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                        <Button Content="Xem danh sách"
                                Margin="0,12,0,0"
                                Padding="14,6"
                                HorizontalAlignment="Center"
                                Command="{Binding ShowProfileCompletionRequiredCommand}" />

                    </StackPanel>

                </Grid>

            </Border>

            <Border Margin="0,24,0,0"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Biến động nhân sự"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Text="Gia nhập, nghỉ việc và tỷ lệ nghỉ việc theo kỳ"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Width="100"
                                  Height="32"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding AnalyticsYears}"
                                  SelectedItem="{Binding SelectedAnalyticsYear, Mode=TwoWay}" />

                                                <ComboBox Grid.Column="3"
                                  Width="120"
                                  Height="32"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding AnalyticsGroupingOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedAnalyticsGroupingOption, Mode=TwoWay}" />

                        <Button Grid.Column="5"
                                Width="90"
                                Height="32"
                                VerticalAlignment="Center"
                                Content="Áp dụng"
                                Command="{Binding RefreshAnalyticsCommand}" />

                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="6">

                            <StackPanel>
                                <TextBlock Text="Gia nhập"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock Text="{Binding TotalNewHires}"
                               Margin="0,8,0,0"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="16"
                                Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="6">

                            <StackPanel>
                                <TextBlock Text="Nghỉ việc"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock Text="{Binding TotalSeparations}"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Padding="16"
                                Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="6">

                            <StackPanel>
                                <TextBlock Text="Biến động ròng"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock Text="{Binding WorkforceNetChangeDisplay}"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6"
                                Padding="16"
                                Background="{DynamicResource PageBackgroundBrush}"
                                CornerRadius="6">

                            <StackPanel>
                                <TextBlock Text="Turnover rate"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock Text="{Binding WorkforceTurnoverRate,
                                             StringFormat={}{0:F2}%}"
                                           Margin="0,8,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Margin="0,16,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}">
            <Run Text="Headcount đầu kỳ: " />
            <Run Text="{Binding AnalyticsBeginningHeadcount}" />
            <Run Text="   •   Cuối kỳ: " />
            <Run Text="{Binding AnalyticsEndingHeadcount}" />
            <Run Text="   •   Bình quân: " />
            <Run Text="{Binding WorkforceAverageHeadcount,
                                StringFormat={}{0:F2}}" />
                    </TextBlock>

                    <TextBlock Margin="0,10,0,0"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                            Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EmployeesWithUnknownTerminationDate}"
                                     Value="0">
                                        <Setter Property="Visibility"
                                    Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
            <Run Text="⚠ Có " />
            <Run Text="{Binding EmployeesWithUnknownTerminationDate}" />
            <Run Text=" hồ sơ nghỉ việc cũ chưa có ngày nghỉ và chưa được tính vào thống kê." />
                    </TextBlock>

                    <!-- Bọc Legend + Chart -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkforceMovementData}"
                                     Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal"
                        Margin="0,22,0,12">
                            <Border Width="12"
                        Height="12"
                        CornerRadius="2"
                        Background="{DynamicResource NewHireBrush}"
                        VerticalAlignment="Center" />
                            <TextBlock Text="Gia nhập"
                           Margin="6,0,20,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Border Width="12"
                        Height="12"
                        CornerRadius="2"
                        Background="{DynamicResource SeparationBrush}"
                        VerticalAlignment="Center" />
                            <TextBlock Text="Nghỉ việc"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <!-- Grouped Column Chart -->
                        <Grid Height="235">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Y axis -->
                            <Grid Grid.Column="0"
                                  Height="190"
                                  Margin="0,0,8,25">
                                <TextBlock Text="{Binding WorkforceMovementChartMaximum}"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding WorkforceMovementChartMidpoint}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="0"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                            <Grid Grid.Column="1">
                                <!-- Horizontal guides -->
                                <Grid Height="190"
                          Margin="0,0,0,25">
                                    <Border Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource BorderBrush}" />
                                    <Border Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BorderBrush}" />
                                    <Border Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource BorderBrush}" />
                                </Grid>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="DashboardContent_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding WorkforceMovementItems}"
                                      MinWidth="720">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,0">
                                                    <Grid Height="200">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="4" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- New hires -->
                                                        <StackPanel Grid.Column="0"
                                                        VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding NewHires}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4"
                                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NewHires}" Value="0">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Width="18"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource NewHireBrush}"
                                                        CornerRadius="3,3,0,0">
                                                                <Border.Height>
                                                                    <MultiBinding Converter="{StaticResource WorkforceBarHeightConverter}"
                                                                      ConverterParameter="180">
                                                                        <Binding Path="NewHires" />
                                                                        <Binding Path="DataContext.WorkforceMovementChartMaximum"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                    </MultiBinding>
                                                                </Border.Height>
                                                                <Border.ToolTip>
                                                                    <ToolTip>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" />
                                                                            <TextBlock>
                                                                    <Run Text="Gia nhập: " />
                                                                    <Run Text="{Binding NewHires}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- Separations -->
                                                        <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding Separations}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,4"
                                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Separations}" Value="0">
                                                                                <Setter Property="Visibility" Value="Hidden" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Border Width="18"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource SeparationBrush}"
                                                        CornerRadius="3,3,0,0">
                                                                <Border.Height>
                                                                    <MultiBinding Converter="{StaticResource WorkforceBarHeightConverter}"
                                                                      ConverterParameter="180">
                                                                        <Binding Path="Separations" />
                                                                        <Binding Path="DataContext.WorkforceMovementChartMaximum"
                                                                     RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                                    </MultiBinding>
                                                                </Border.Height>
                                                                <Border.ToolTip>
                                                                    <ToolTip>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                           FontWeight="SemiBold" />
                                                                            <TextBlock>
                                                                    <Run Text="Nghỉ việc: " />
                                                                    <Run Text="{Binding Separations}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </Border.ToolTip>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- Message khi không có dữ liệu -->
                    <TextBlock Text="Chưa có biến động nhân sự trong năm được chọn."
                   HorizontalAlignment="Center"
                   Margin="0,28"
                   Foreground="{DynamicResource SecondaryTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasWorkforceMovementData}"
                                     Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding AnalyticsErrorMessage}"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,30,0,0"
                    Padding="30"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>

                    <TextBlock Text="Nhân viên vào làm gần đây"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,16" />

                    <Grid>

                        <DataGrid ItemsSource="{Binding RecentEmployees}"
                                  PreviewMouseWheel="DashboardContent_PreviewMouseWheel"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent">

                            <DataGrid.Style>
                                <Style TargetType="{x:Type DataGrid}"
                                       BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentEmployees.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã nhân viên"
                                Width="120"
                                Binding="{Binding EmployeeCode}" />

                                <DataGridTextColumn Header="Họ và tên"
                                Width="*"
                                Binding="{Binding FullName}" />

                                <DataGridTextColumn Header="Phòng ban"
                                Width="180"
                                Binding="{Binding Department}" />

                                <DataGridTextColumn Header="Chức vụ"
                                Width="180"
                                Binding="{Binding Position}" />

                                <DataGridTextColumn Header="Ngày vào làm"
                                Width="130"
                                Binding="{Binding HireDate,
                                                  StringFormat={}{0:dd/MM/yyyy}}" />

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock Text="Chưa có dữ liệu nhân viên."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,24"
                                   Foreground="{DynamicResource SecondaryTextBrush}">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentEmployees.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </StackPanel>

            </Border>

            <Border Margin="0,24,0,24"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>

                    <TextBlock Text="Phân bổ nhân sự theo phòng ban"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,16" />

                    <Grid>

                        <DataGrid ItemsSource="{Binding Departments}"
                                  PreviewMouseWheel="DashboardContent_PreviewMouseWheel"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent">

                            <DataGrid.Style>
                                <Style TargetType="{x:Type DataGrid}"
                                       BasedOn="{StaticResource {x:Type DataGrid}}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Departments.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Phòng ban"
                                                    Width="*"
                                                    Binding="{Binding Department}" />

                                <DataGridTextColumn Header="Tổng nhân viên"
                                                    Width="140"
                                                    Binding="{Binding TotalEmployees}" />

                                <DataGridTextColumn Header="Đang làm việc"
                                                    Width="140"
                                                    Binding="{Binding ActiveEmployees}" />

                                <DataGridTextColumn Header="Đang nghỉ"
                                                    Width="120"
                                                    Binding="{Binding EmployeesOnLeave}" />

                                <DataGridTextColumn Header="Ngừng hoạt động"
                                                    Width="150"
                                                    Binding="{Binding InactiveEmployees}" />

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock Text="Chưa có dữ liệu phòng ban."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,24"
                                   Foreground="{DynamicResource SecondaryTextBrush}">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Departments.Count}"
                                                     Value="0">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </StackPanel>

            </Border>
        </StackPanel>

    </ScrollViewer>

</UserControl>
