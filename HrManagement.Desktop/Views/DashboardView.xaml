<UserControl x:Class="HrManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Tổng quan"
                           Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="Tình hình nhân sự hiện tại"
                           Margin="0,6,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <!-- KPI cards -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Employees -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Tổng nhân viên"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding TotalEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Active Employees -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang làm việc"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding ActiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Employees On Leave -->
                <Border Grid.Column="4"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang nghỉ"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding EmployeesOnLeave}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Contracts Expiring -->
                <Border Grid.Column="6"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Ngừng hoạt động"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding InactiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

            </Grid>

            <Border Margin="0,30,0,0"
Padding="30"
Background="{DynamicResource CardBackgroundBrush}"
BorderBrush="{DynamicResource BorderBrush}"
BorderThickness="1"
CornerRadius="8">

                <StackPanel>

                    <TextBlock Text="Nhân viên vào làm gần đây"
           FontSize="18"
           FontWeight="SemiBold"
           Foreground="{DynamicResource PrimaryTextBrush}"
           Margin="0,0,0,16" />

                    <Grid>

                        <DataGrid ItemsSource="{Binding RecentEmployees}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              BorderThickness="0"
              Background="Transparent">

                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility"
                        Value="Visible" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentEmployees.Count}"
                                 Value="0">
                                            <Setter Property="Visibility"
                                Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Mã nhân viên"
                                Width="120"
                                Binding="{Binding EmployeeCode}" />

                                <DataGridTextColumn Header="Họ và tên"
                                Width="*"
                                Binding="{Binding FullName}" />

                                <DataGridTextColumn Header="Phòng ban"
                                Width="180"
                                Binding="{Binding Department}" />

                                <DataGridTextColumn Header="Chức vụ"
                                Width="180"
                                Binding="{Binding Position}" />

                                <DataGridTextColumn Header="Ngày vào làm"
                                Width="130"
                                Binding="{Binding HireDate,
                                                  StringFormat={}{0:dd/MM/yyyy}}" />

                            </DataGrid.Columns>

                        </DataGrid>

                        <TextBlock Text="Chưa có dữ liệu nhân viên."
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="0,24"
               Foreground="{DynamicResource SecondaryTextBrush}">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                        Value="Collapsed" />

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentEmployees.Count}"
                                 Value="0">
                                            <Setter Property="Visibility"
                                Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                </StackPanel>

            </Border>

        </Grid>
        
    </ScrollViewer>

</UserControl>
