<UserControl x:Class="HrManagement.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Tổng quan"
                           Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="Tình hình nhân sự hiện tại"
                           Margin="0,6,0,0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <!-- KPI cards -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Employees -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Tổng nhân viên"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding TotalEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Active Employees -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang làm việc"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding ActiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Employees On Leave -->
                <Border Grid.Column="4"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Đang nghỉ"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding EmployeesOnLeave}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Contracts Expiring -->
                <Border Grid.Column="6"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Ngừng hoạt động"
                                   Style="{StaticResource SecondaryTextStyle}" />

                        <TextBlock Text="{Binding InactiveEmployees}"
                                   Margin="0,12,0,0"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </ScrollViewer>

</UserControl>
