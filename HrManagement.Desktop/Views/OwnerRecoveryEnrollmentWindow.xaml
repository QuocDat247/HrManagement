<Window x:Class="HrManagement.Desktop.Views.OwnerRecoveryEnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập mã khôi phục - HR Management"
        Width="560"
        MinWidth="560"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},
                            Path=Height}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Margin="24"
                    Padding="30"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <Border Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="12">

                        <TextBlock Text="🔑"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="22" />

                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               Text="THIẾT LẬP MÃ KHÔI PHỤC"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="21"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,9,0,24"
                               Text="Tài khoản Owner này chưa có mã khôi phục. Hãy lưu mã bên dưới ở nơi an toàn trước khi tiếp tục."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="Recovery Code"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold" />

                    <TextBox x:Name="RecoveryCodeTextBox"
                             MinHeight="78"
                             Padding="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Text="{Binding RecoveryCode,
                                            Mode=OneWay}" />

                    <TextBlock Margin="0,12,0,8"
                               Text="Mã này sẽ không được hiển thị lại sau khi bạn hoàn tất bước này."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,0,0,20"
                               Text="Không lưu mã khôi phục cùng mật khẩu Owner. Nếu mất cả mật khẩu lẫn mã khôi phục, hệ thống sẽ không thể tự khôi phục tài khoản bằng cơ chế này."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <Border MinHeight="48"
                            Margin="0,0,0,12">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />

                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Hủy"
                                Width="90"
                                Margin="0,0,8,0"
                                IsCancel="True" />

                        <Button Content="Tôi đã lưu mã"
                                Width="150"
                                MinHeight="40"
                                IsDefault="True"
                                IsEnabled="{Binding CanSubmit}"
                                Command="{Binding ConfirmSavedCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                FontWeight="SemiBold" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>
