<Window x:Class="HrManagement.Desktop.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu - HR Management"
        Width="520"
        Height="613"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <Border Margin="24"
                Padding="28"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>

                <TextBlock Text="Đổi mật khẩu"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,6,0,24"
                           Text="Nhập mật khẩu hiện tại và chọn mật khẩu mới cho tài khoản đang đăng nhập."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="Mật khẩu hiện tại"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <PasswordBox x:Name="CurrentPasswordBox"
                             MinHeight="40"
                             MaxLength="128"
                             Margin="0,0,0,18" />

                <TextBlock Text="Mật khẩu mới"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <PasswordBox x:Name="NewPasswordBox"
                             MinHeight="40"
                             MaxLength="128"
                             Margin="0,0,0,6" />

                <TextBlock Margin="0,0,0,18"
                           Text="Từ 15 đến 128 ký tự. Không sử dụng mật khẩu phổ biến hoặc trùng mật khẩu hiện tại."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="Xác nhận mật khẩu mới"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <PasswordBox x:Name="ConfirmPasswordBox"
                             MinHeight="40"
                             MaxLength="128"
                             Margin="0,0,0,12" />

                <Border MinHeight="52"
                        Margin="0,0,0,12">

                    <TextBlock Text="{Binding ErrorMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />

                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Hủy"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True" />

                    <Button x:Name="ChangePasswordButton"
                            Content="Đổi mật khẩu"
                            Width="130"
                            IsDefault="True"
                            IsEnabled="{Binding CanSubmit}"
                            Click="ChangePasswordButton_Click"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold" />

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>
