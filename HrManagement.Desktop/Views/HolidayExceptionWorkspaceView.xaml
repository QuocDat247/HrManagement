<UserControl x:Class="HrManagement.Desktop.Views.HolidayExceptionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="HolidayExceptionWorkspaceView_Loaded">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILTER -->
        <Border Grid.Row="0"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,5"
                           Text="Năm"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,10,5"
                           Text="Lịch làm việc"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <ComboBox x:Name="YearSelector"
                          Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding YearOptions}"
                          SelectedItem="{Binding SelectedYear,
                                                Mode=TwoWay}"
                          SelectionChanged="YearSelector_SelectionChanged" />

                <ComboBox x:Name="ScheduleSelector"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding ScheduleItems}"
                          SelectedItem="{Binding SelectedScheduleItem,
                                                Mode=TwoWay}"
                          SelectionChanged="ScheduleSelector_SelectionChanged">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code}" />
                                <Run Text=" - " />
                                <Run Text="{Binding Name}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <Button Grid.Row="1"
                        Grid.Column="2"
                        MinHeight="32"
                        Content="Làm mới"
                        Command="{Binding RefreshCommand}" />

            </Grid>

        </Border>

        <!-- MESSAGE -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,10">

            <TextBlock Text="{Binding OperationMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryBrush}"
                       FontWeight="SemiBold" />

            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       FontWeight="SemiBold" />

        </StackPanel>

        <!-- CONTENT -->
        <TabControl Grid.Row="2">

            <!-- HOLIDAYS -->
            <TabItem Header="Ngày lễ toàn công ty">

                <Grid Margin="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- LIST -->
                    <Border Grid.Column="0"
                            Style="{DynamicResource CardBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,12">

                                <TextBlock Text="Ngày lễ và ngày đặc biệt"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock Margin="0,4,0,0"
                                           Text="Ngày lễ đang áp dụng sẽ làm ngày đó trở thành ngày nghỉ, trừ khi lịch làm việc có ngoại lệ riêng."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding HolidayItems}"
                                      SelectedItem="{Binding SelectedHolidayItem,
                                                            Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserAddRows="False">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Ngày"
                                                        Width="130"
                                                        Binding="{Binding Date}" />

                                    <DataGridTextColumn Header="Tên"
                                                        Width="*"
                                                        Binding="{Binding Name}" />

                                    <DataGridCheckBoxColumn Header="Đang áp dụng"
                                                            Width="110"
                                                            Binding="{Binding IsActive}" />

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                    <!-- EDITOR -->
                    <Border Grid.Column="2"
                            Style="{DynamicResource CardBorderStyle}">

                        <StackPanel>

                            <TextBlock Text="Chi tiết ngày lễ"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Margin="0,14,0,5"
                                       Text="Ngày"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <DatePicker SelectedDate="{Binding HolidayEditorDate,
                                                              Mode=TwoWay}"
                                        MinHeight="32">

                                <DatePicker.Style>
                                    <Style TargetType="{x:Type DatePicker}"
                                           BasedOn="{StaticResource {x:Type DatePicker}}">
                                        <Setter Property="IsEnabled"
                                                Value="True" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditingExistingHoliday}"
                                                         Value="True">
                                                <Setter Property="IsEnabled"
                                                        Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DatePicker.Style>

                            </DatePicker>

                            <TextBlock Margin="0,12,0,5"
                                       Text="Tên ngày lễ"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <TextBox MinHeight="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding HolidayEditorName,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}" />

                            <WrapPanel Margin="0,16,0,0">

                                <Button Margin="0,0,8,8"
                                        Padding="12,6"
                                        Content="Ngày lễ mới"
                                        Command="{Binding NewHolidayCommand}" />

                                <Button Margin="0,0,8,8"
                                        Padding="12,6"
                                        Content="Lưu"
                                        Command="{Binding SaveHolidayCommand}" />

                                <Button Margin="0,0,8,8"
                                        Padding="12,6"
                                        Content="Ngừng áp dụng"
                                        IsEnabled="{Binding IsEditingExistingHoliday}"
                                        Command="{Binding DeactivateHolidayCommand}" />

                                <Button Margin="0,0,8,8"
                                        Padding="12,6"
                                        Content="Áp dụng lại"
                                        IsEnabled="{Binding IsEditingExistingHoliday}"
                                        Command="{Binding ReactivateHolidayCommand}" />

                            </WrapPanel>

                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="Ngày của một bản ghi đã tạo là bất biến. Nếu chọn nhầm ngày, hãy ngừng áp dụng bản ghi cũ và tạo bản ghi đúng." />

                        </StackPanel>

                    </Border>

                </Grid>

            </TabItem>

            <!-- OVERRIDES -->
            <TabItem Header="Ngoại lệ theo lịch làm việc">

                <Grid Margin="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- LIST -->
                    <Border Grid.Column="0"
                            Style="{DynamicResource CardBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,12">

                                <TextBlock Text="Ngoại lệ ngày cụ thể"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock Margin="0,4,0,0"
                                           Text="Ngoại lệ của lịch được ưu tiên cao hơn ngày lễ và cấu hình ngày trong tuần."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding OverrideItems}"
                                      SelectedItem="{Binding SelectedOverrideItem,
                                                            Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserAddRows="False">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Ngày"
                                                        Width="105"
                                                        Binding="{Binding WorkDate}" />

                                    <DataGridCheckBoxColumn Header="Làm việc"
                                                            Width="75"
                                                            Binding="{Binding IsWorkingDay}" />

                                    <DataGridTextColumn Header="Bắt đầu"
                                                        Width="80"
                                                        Binding="{Binding StartTime}" />

                                    <DataGridTextColumn Header="Kết thúc"
                                                        Width="80"
                                                        Binding="{Binding EndTime}" />

                                    <DataGridTextColumn Header="Nghỉ"
                                                        Width="65"
                                                        Binding="{Binding BreakMinutes}" />

                                    <DataGridTextColumn Header="Phút KH"
                                                        Width="75"
                                                        Binding="{Binding PlannedMinutes}" />

                                    <DataGridCheckBoxColumn Header="Qua đêm"
                                                            Width="75"
                                                            Binding="{Binding IsOvernight}" />

                                    <DataGridTextColumn Header="Ghi chú"
                                                        Width="*"
                                                        Binding="{Binding Note}" />

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                    <!-- EDITOR -->
                    <Border Grid.Column="2"
                            Style="{DynamicResource CardBorderStyle}">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="Chi tiết ngoại lệ"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock Margin="0,14,0,5"
                                           Text="Lịch làm việc"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}">
                                    <Run Text="{Binding SelectedScheduleItem.Code}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding SelectedScheduleItem.Name}" />
                                </TextBlock>

                                <TextBlock Margin="0,12,0,5"
                                           Text="Ngày ngoại lệ"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <DatePicker SelectedDate="{Binding OverrideEditorWorkDate,
                                                                  Mode=TwoWay}"
                                            MinHeight="32">

                                    <DatePicker.Style>
                                        <Style TargetType="{x:Type DatePicker}"
                                               BasedOn="{StaticResource {x:Type DatePicker}}">
                                            <Setter Property="IsEnabled"
                                                    Value="True" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingExistingOverride}"
                                                             Value="True">
                                                    <Setter Property="IsEnabled"
                                                            Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DatePicker.Style>

                                </DatePicker>

                                <CheckBox Margin="0,14,0,0"
                                          Content="Đây là ngày làm việc"
                                          IsChecked="{Binding OverrideEditorIsWorkingDay,
                                                              Mode=TwoWay}" />

                                <Grid Margin="0,12,0,0"
                                      IsEnabled="{Binding OverrideEditorIsWorkingDay}">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Margin="0,0,0,5"
                                                   Text="Bắt đầu (HH:mm)"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <TextBox MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding OverrideEditorStartTimeText,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock Margin="0,0,0,5"
                                                   Text="Kết thúc (HH:mm)"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <TextBox MinHeight="32"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding OverrideEditorEndTimeText,
                                                              Mode=TwoWay,
                                                              UpdateSourceTrigger=PropertyChanged}" />

                                    </StackPanel>

                                </Grid>

                                <TextBlock Margin="0,12,0,5"
                                           Text="Thời gian nghỉ (phút)"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBox MinHeight="32"
                                         IsEnabled="{Binding OverrideEditorIsWorkingDay}"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding OverrideEditorBreakMinutesText,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,5"
                                           Text="Ghi chú"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <TextBox MinHeight="70"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding OverrideEditorNote,
                                                      Mode=TwoWay,
                                                      UpdateSourceTrigger=PropertyChanged}" />

                                <WrapPanel Margin="0,16,0,0">

                                    <Button Margin="0,0,8,8"
                                            Padding="12,6"
                                            Content="Ngoại lệ mới"
                                            Command="{Binding NewOverrideCommand}" />

                                    <Button Margin="0,0,8,8"
                                            Padding="12,6"
                                            Content="Lưu"
                                            Command="{Binding SaveOverrideCommand}" />

                                    <Button Margin="0,0,8,8"
                                            Padding="12,6"
                                            Content="Xóa"
                                            IsEnabled="{Binding IsEditingExistingOverride}"
                                            Command="{Binding DeleteOverrideCommand}" />

                                </WrapPanel>

                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="Nếu bỏ chọn ngày làm việc, giờ bắt đầu, giờ kết thúc và thời gian nghỉ sẽ không được sử dụng." />

                            </StackPanel>

                        </ScrollViewer>

                    </Border>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</UserControl>
