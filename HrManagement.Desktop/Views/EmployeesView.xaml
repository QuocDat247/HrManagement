<UserControl x:Class="HrManagement.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nhân viên"
                   Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="Danh sách nhân viên trong hệ thống"
                   Margin="0,6,0,0"
                   Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="140"
                    Height="36"
                    Content="Ngừng hoạt động"
                    Command="{Binding DeactivateEmployeeCommand}" />

            <Button Grid.Column="3"
                    Width="120"
                    Height="36"
                    Content="Sửa nhân viên"
                    Command="{Binding EditEmployeeCommand}" />

            <Button Grid.Column="5"
                    Width="130"
                    Height="36"
                    Content="Thêm nhân viên"
                    Command="{Binding AddEmployeeCommand}" />

        </Grid>

        <!-- Search / Filter -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
             Height="36"
             Padding="10,6"
             VerticalContentAlignment="Center"
             Text="{Binding SearchText,
                            UpdateSourceTrigger=PropertyChanged}">

                <TextBox.InputBindings>
                    <KeyBinding Key="Enter"
                        Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <ComboBox Grid.Column="2"
              Height="36"
              ItemsSource="{Binding StatusOptions}"
              DisplayMemberPath="DisplayName"
              SelectedItem="{Binding SelectedStatusOption}" />

            <Button Grid.Column="4"
            Height="36"
            Content="Tìm kiếm"
            Command="{Binding SearchCommand}" />

            <Button Grid.Column="6"
            Height="36"
            Content="Xóa lọc"
            Command="{Binding ClearFiltersCommand}" />

        </Grid>

        <!-- Employee table -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorderStyle}">

            <DataGrid ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Mã NV"
                                        Binding="{Binding EmployeeCode}"
                                        Width="110" />

                    <DataGridTextColumn Header="Họ và tên"
                                        Binding="{Binding FullName}"
                                        Width="*" />

                    <DataGridTextColumn Header="Phòng ban"
                                        Binding="{Binding Department}"
                                        Width="180" />

                    <DataGridTextColumn Header="Chức vụ"
                                        Binding="{Binding Position}"
                                        Width="220" />

                    <DataGridTextColumn Header="Trạng thái"
                                        Binding="{Binding Status}"
                                        Width="130" />

                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>

</UserControl>
