<UserControl x:Class="HrManagement.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HrManagement.Desktop.Converters">

    <UserControl.Resources>
        <converters:EmployeeProfileWarningConverter x:Key="EmployeeProfileWarningConverter" />
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="31*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>



        <!-- Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Nhân viên"
                   Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="Danh sách nhân viên trong hệ thống"
                   Margin="0,6,0,0"
                   Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Width="140"
                    Height="36"
                    Content="Ngừng hoạt động"
                    Command="{Binding DeactivateEmployeeCommand}" />

            <Button Grid.Column="3"
                    Width="120"
                    Height="36"
                    Content="Sửa nhân viên"
                    Command="{Binding EditEmployeeCommand}" />

            <Button Grid.Column="5"
                    Width="130"
                    Height="36"
                    Content="Thêm nhân viên"
                    Command="{Binding AddEmployeeCommand}" />

        </Grid>



        <!-- Search / Filter -->
        <Grid Grid.ColumnSpan="3" Margin="0,75,0,0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
             Height="36"
             Padding="10,6"
             VerticalContentAlignment="Center"
             Text="{Binding SearchText,
                            UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" Margin="0,0,12,0" Grid.RowSpan="2">

                <TextBox.InputBindings>
                    <KeyBinding Key="Enter"
                        Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>

            </TextBox>

            <ComboBox Grid.Column="2"
              Height="36"
              ItemsSource="{Binding StatusOptions}"
              DisplayMemberPath="DisplayName"
              SelectedItem="{Binding SelectedStatusOption}" Grid.ColumnSpan="2" Margin="0,0,12,0" Grid.RowSpan="2" />

            <Button Grid.Column="4"
            Height="36"
            Content="Tìm kiếm"
            Command="{Binding SearchCommand}" Grid.ColumnSpan="2" Margin="0,0,8,0" Grid.RowSpan="2" />

            <Button Grid.Column="6"
            Height="36"
            Content="Xóa lọc"
            Command="{Binding ClearFiltersCommand}" Grid.RowSpan="2" />

        </Grid>

        <CheckBox Content="Chỉ hiển thị hồ sơ cần bổ sung"
                IsChecked="{Binding RequiresProfileCompletionOnly,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                Command="{Binding SearchCommand}"
                Margin="0,0,198,0"
                VerticalAlignment="Top" Height="21" Grid.ColumnSpan="2" Grid.Row="3" />

        <!-- Employee table -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorderStyle}" Grid.ColumnSpan="3" Margin="0,16,0,0" Grid.RowSpan="2">

            <DataGrid ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">


                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Hồ sơ"
                        Width="70">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Text="⚠"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RequiresProfileCompletion}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>

                                    <TextBlock.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Converter={StaticResource EmployeeProfileWarningConverter}}" />
                                        </ToolTip>
                                    </TextBlock.ToolTip>

            </TextBlock>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã NV"
                                        Width="100"
                                        Binding="{Binding EmployeeCode}" />

                    <DataGridTextColumn Header="Họ và tên"
                                        Width="SizeToCells"
                                        MinWidth="160"
                                        Binding="{Binding FullName}" />

                    <DataGridTextColumn Header="Phòng ban"
                                        Width="*"
                                        MinWidth="140"
                                        Binding="{Binding Department}" />

                    <DataGridTextColumn Header="Chức vụ"
                                        Width="*"
                                        MinWidth="160"
                                        Binding="{Binding Position}" />

                    <DataGridTextColumn Header="Trạng thái"
                                        Width="120"
                                        Binding="{Binding Status}" />

                </DataGrid.Columns>

            </DataGrid>
        </Border>

    </Grid>

</UserControl>
