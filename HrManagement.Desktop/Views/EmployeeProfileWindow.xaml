<Window x:Class="HrManagement.Desktop.Views.EmployeeProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hồ sơ nhân viên"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Loaded="EmployeeProfileWindow_Loaded">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>

            <TextBlock Text="Hồ sơ nhân viên"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBlock Margin="0,6,0,0"
                       Text="Thông tin hồ sơ nhân sự và các dữ liệu liên quan."
                       Foreground="{DynamicResource SecondaryTextBrush}" />

        </StackPanel>

        <!-- Employee summary -->
        <Border Grid.Row="1"
                Margin="0,20,0,18"
                Padding="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource PageBackgroundBrush}">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="{Binding FullName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="Mã nhân viên: " />
                        <Run Text="{Binding EmployeeCode}" />
                    </TextBlock>

                </StackPanel>

                <StackPanel Grid.Column="1">

                    <TextBlock Text="{Binding Department}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Position}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding StatusText}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- Phase 16 profile workspace -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- Personal information -->
                <Border Padding="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">

                    <StackPanel
                        DataContext="{Binding PersonalInformation}">

                        <TextBlock Text="Thông tin cá nhân"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,5,0,18"
                                   Text="Thông tin cá nhân mở rộng phục vụ hồ sơ nhân sự."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Preferred name -->
                            <StackPanel>

                                <TextBlock Text="Tên thường dùng" />

                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding PreferredName,
                                                UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                            <!-- Gender -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Giới tính" />

                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding GenderOptions}"
                                          SelectedItem="{Binding SelectedGender}"
                                          DisplayMemberPath="DisplayName"
                                          IsSynchronizedWithCurrentItem="False" />

                            </StackPanel>

                            <!-- Nationality -->
                            <StackPanel Grid.Row="1"
                                        Margin="0,16,0,0">

                                <TextBlock Text="Quốc tịch" />

                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding Nationality,
                                                UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                            <!-- Place of birth -->
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,16,0,0">

                                <TextBlock Text="Nơi sinh" />

                                <TextBox Margin="0,6,0,0"
                                         Text="{Binding PlaceOfBirth,
                                                UpdateSourceTrigger=PropertyChanged}" />

                            </StackPanel>

                        </Grid>

                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding SuccessMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <Button Margin="0,18,0,0"
                                Width="150"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                Content="Lưu thông tin"
                                Command="{Binding SaveCommand}" />

                    </StackPanel>

                </Border>

                <Border Margin="0,18,0,0"
                        Padding="18"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        DataContext="{Binding Addresses}">

                    <StackPanel>

                        <TextBlock Text="Địa chỉ"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,5,0,18"
                                   Text="Địa chỉ thường trú và địa chỉ hiện tại của nhân viên."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}" />

                        <!-- Permanent address -->
                        <Border Padding="14"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                DataContext="{Binding PermanentAddress}">

                            <StackPanel>

                                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="15" />

                                <TextBlock Margin="0,14,0,0"
                           Text="Địa chỉ chi tiết" />

                                <TextBox Margin="0,6,0,0"
                         Text="{Binding AddressLine,
                                UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Phường/Xã" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Ward,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quận/Huyện" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding District,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                                        <TextBlock Text="Tỉnh/Thành phố" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Province,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,14,0,0">
                                        <TextBlock Text="Mã bưu chính" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding PostalCode,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                           Text="Quốc gia" />

                                <TextBox Margin="0,6,0,0"
                         Text="{Binding Country,
                                UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,0"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" />

                                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SuccessMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <StackPanel Margin="0,14,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Xóa"
                            Command="{Binding DeleteCommand}" />

                                    <Button Width="110"
                            Content="Lưu địa chỉ"
                            Command="{Binding SaveCommand}" />

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <!-- Current address -->
                        <Border Margin="0,16,0,0"
                Padding="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                DataContext="{Binding CurrentAddress}">

                            <StackPanel>

                                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="15" />

                                <TextBlock Margin="0,14,0,0"
                           Text="Địa chỉ chi tiết" />

                                <TextBox Margin="0,6,0,0"
                         Text="{Binding AddressLine,
                                UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Phường/Xã" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Ward,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Quận/Huyện" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding District,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">
                                        <TextBlock Text="Tỉnh/Thành phố" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Province,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,14,0,0">
                                        <TextBlock Text="Mã bưu chính" />
                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding PostalCode,
                                        UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                           Text="Quốc gia" />

                                <TextBox Margin="0,6,0,0"
                         Text="{Binding Country,
                                UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,12,0,0"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" />

                                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SuccessMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                                <StackPanel Margin="0,14,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Xóa"
                            Command="{Binding DeleteCommand}" />

                                    <Button Width="110"
                            Content="Lưu địa chỉ"
                            Command="{Binding SaveCommand}" />

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

                <Border Margin="0,18,0,0"
        Padding="18"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        DataContext="{Binding EmergencyContacts}">

                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Liên hệ khẩn cấp"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                                <TextBlock Margin="0,5,0,0"
                           Text="Người có thể liên hệ khi xảy ra tình huống khẩn cấp."
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                    Width="110"
                    Height="32"
                    Content="Thêm mới"
                    Command="{Binding NewCommand}" />
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" />

                        <TextBlock Margin="0,6,0,0"
                   Text="{Binding SuccessMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <!-- Contact list -->
                        <ListBox Margin="0,16,0,0"
         MinHeight="80"
         MaxHeight="220"
         ItemsSource="{Binding Contacts}"
         SelectedItem="{Binding SelectedContact,
                                Mode=TwoWay}"
         HorizontalContentAlignment="Stretch"
         PreviewMouseWheel="EmergencyContactsList_PreviewMouseWheel">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

                                    <Setter Property="Padding"
                    Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <Grid Margin="10,8">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tên -->
                                        <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="{Binding FullName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />

                                        <!-- Primary badge -->
                                        <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           Text="Liên hệ chính"
                           FontWeight="SemiBold">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility"
                                    Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsPrimary}"
                                             Value="True">

                                                            <Setter Property="Visibility"
                                            Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                        <!-- Quan hệ -->
                                        <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,5,0,0"
                           Text="{Binding Relationship}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />

                                        <!-- Điện thoại -->
                                        <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="12,5,0,0"
                           Text="{Binding PhoneNumber}"
                           TextTrimming="CharacterEllipsis" />

                                        <!-- Email -->
                                        <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Margin="12,5,0,0"
                           Text="{Binding Email}"
                           TextTrimming="CharacterEllipsis" />

                                    </Grid>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                        <!-- Editor -->
                        <Border Margin="0,16,0,0"
                Padding="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">

                            <StackPanel>

                                <TextBlock Text="Thông tin liên hệ"
                           FontSize="15"
                           FontWeight="SemiBold" />

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Họ và tên" />

                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding FullName,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mối quan hệ" />

                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Relationship,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,0">

                                        <TextBlock Text="Số điện thoại" />

                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding PhoneNumber,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,14,0,0">

                                        <TextBlock Text="Email" />

                                        <TextBox Margin="0,6,0,0"
                                 Text="{Binding Email,
                                                UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                </Grid>

                                <CheckBox Margin="0,14,0,0"
                          Content="Đặt làm liên hệ chính"
                          IsChecked="{Binding IsPrimary,
                                              Mode=TwoWay}" />

                                <StackPanel Margin="0,16,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                                    <Button Width="90"
                            Margin="0,0,8,0"
                            Content="Xóa"
                            Command="{Binding DeleteCommand}" />

                                    <Button Width="120"
                            Content="Lưu liên hệ"
                            Command="{Binding SaveCommand}" />

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="3"
                Width="90"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Content="Đóng"
                IsCancel="True" />

    </Grid>

</Window>
