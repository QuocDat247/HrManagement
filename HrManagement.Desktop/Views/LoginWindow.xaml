<Window x:Class="HrManagement.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - HR Management"
        Width="480"
        Height="700"
        MinWidth="480"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LOGIN CARD -->
        <Border Grid.Row="0"
                Width="390"
                Padding="32"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">

            <StackPanel>

                <!-- BRAND -->
                <Border Width="56"
                        Height="56"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PrimaryBrush}"
                        CornerRadius="12">

                    <TextBlock Text="HR"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White" />

                </Border>

                <TextBlock x:Name="ProductDisplayNameTextBlock"
                           Margin="0,18,0,0"
                           Text="HR Management"
                           HorizontalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock x:Name="CustomerDisplayNameTextBlock"
                           Margin="0,7,0,28"
                           Text="Bản tiêu chuẩn"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <!-- USERNAME -->
                <TextBlock Text="Tên đăng nhập"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBox x:Name="UsernameTextBox"
                         MinHeight="40"
                         Margin="0,0,0,18"
                         VerticalContentAlignment="Center"
                         Text="{Binding Username,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <!-- PASSWORD -->
                <TextBlock Text="Mật khẩu"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <PasswordBox x:Name="PasswordBox"
                             MinHeight="40"
                             Margin="0,0,0,12" />

                <!-- ERROR -->
                <Border MinHeight="44"
                        Margin="0,0,0,12">

                    <TextBlock Text="{Binding ErrorMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SeparationBrush}" />

                </Border>

                <!-- LOGIN -->
                <Button x:Name="LoginButton"
                        Height="42"
                        Content="Đăng nhập"
                        Click="LoginButton_Click"
                        IsDefault="True"
                        Background="{DynamicResource PrimaryBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderBrush="{DynamicResource PrimaryBrush}" />

                <Button Content="Quên mật khẩu Owner?"
                        Margin="0,12,0,0"
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Cursor="Hand"
                        Click="ForgotOwnerPasswordButton_Click" />

                <TextBlock Margin="0,12,0,0"
                           Text="Đăng nhập để tiếp tục vào hệ thống."
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

        </Border>

        <!-- FOOTER -->
        <TextBlock x:Name="SupportTextBlock"
                   Grid.Row="1"
                   Margin="24,0,24,18"
                   Text="Hỗ trợ kỹ thuật"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

    </Grid>

</Window>
