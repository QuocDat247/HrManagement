<UserControl x:Class="HrManagement.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="SettingsView_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel MaxWidth="900"
                    HorizontalAlignment="Left">

            <!-- INTRO -->
            <Border Style="{DynamicResource CardBorderStyle}"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="Cài đặt ứng dụng"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Tùy chỉnh giao diện ứng dụng. Các lựa chọn được lưu riêng trên máy hiện tại và sẽ được sử dụng lại ở lần mở tiếp theo."
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <Border Margin="0,18,0,0"
                            Padding="12"
                            Background="{DynamicResource PageBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <StackPanel>

                            <TextBlock Text="Cấu hình hiện tại"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding CurrentThemeText}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding EffectiveAppearanceText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

            <!-- APPEARANCE -->
            <Border Style="{DynamicResource CardBorderStyle}"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,30,0">

                        <TextBlock Text="Chế độ giao diện"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   Text="Chọn giao diện sáng, tối hoặc để ứng dụng sử dụng thiết lập của Windows."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <ComboBox ItemsSource="{Binding AppearanceOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedAppearance,
                                                          Mode=TwoWay}"
                                  MinHeight="36"
                                  MinWidth="260"
                                  HorizontalAlignment="Left" />

                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding AppearanceOptions}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,0,0,8">

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ACCENT -->
            <Border Style="{DynamicResource CardBorderStyle}"
                    Margin="0,0,0,16">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,30,0">

                        <TextBlock Text="Màu chủ đạo"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,7,0,0"
                                   TextWrapping="Wrap"
                                   Text="Màu chủ đạo được sử dụng cho navigation và các thành phần nhấn mạnh."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <ComboBox ItemsSource="{Binding AccentOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedAccent,
                                                          Mode=TwoWay}"
                                  MinHeight="36"
                                  MinWidth="260"
                                  HorizontalAlignment="Left" />

                        <ItemsControl Margin="0,12,0,0"
                                      ItemsSource="{Binding AccentOptions}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <StackPanel Margin="0,0,0,8">

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                    </StackPanel>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- APPLY -->
            <Border Style="{DynamicResource CardBorderStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SeparationBrush}" />

                        <TextBlock Text="{Binding SuccessMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                    </StackPanel>

                    <Button Grid.Column="1"
                            MinWidth="130"
                            MinHeight="38"
                            Padding="18,8"
                            Content="Áp dụng"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanApplyChanges}"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White" />

                </Grid>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
