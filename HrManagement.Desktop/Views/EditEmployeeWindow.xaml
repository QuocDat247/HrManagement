<Window x:Class="HrManagement.Desktop.Views.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa nhân viên"
        Width="520"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Sửa nhân viên"
                       Style="{StaticResource PageTitleTextStyle}" />

            <StackPanel Grid.Row="1"
                        Margin="0,24,0,0">

                <TextBlock Text="Mã nhân viên" />
                <TextBox Margin="0,6,0,12"
                         Text="{Binding EmployeeCode,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Họ và tên" />
                <TextBox Margin="0,6,0,12"
                         Text="{Binding FullName,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Email" />
                <TextBox Margin="0,6,0,12"
                         Text="{Binding Email,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Số điện thoại" />
                <TextBox Margin="0,6,0,12"
                         Text="{Binding PhoneNumber,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Ngày sinh" />
                <DatePicker Margin="0,6,0,12"
                            SelectedDate="{Binding DateOfBirth}" />

                <TextBlock Text="Ngày vào làm" />
                <DatePicker Margin="0,6,0,12"
                            SelectedDate="{Binding HireDate}" />

                <TextBlock Text="Phòng ban" />
                <ComboBox Margin="0,6,0,12"
                    ItemsSource="{Binding DepartmentOptions}"
                    SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}"
                    DisplayMemberPath="Name" />

                <TextBlock Text="Chức vụ" />
                <ComboBox Margin="0,6,0,12"
                    ItemsSource="{Binding PositionOptions}"
                    SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                    DisplayMemberPath="Name" />

                <TextBlock Text="Trạng thái" />
                <ComboBox Margin="0,6,0,12"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="IndianRed"
                           Margin="0,0,0,12" />

                <Button Content="Lưu thay đổi"
                        Height="38"
                        Command="{Binding SaveCommand}" />

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Window>
