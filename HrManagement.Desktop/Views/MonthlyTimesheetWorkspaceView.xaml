<UserControl x:Class="HrManagement.Desktop.Views.MonthlyTimesheetWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="MonthlyTimesheetWorkspaceView_Loaded">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILTER -->
        <Border Grid.Row="0"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,5"
                           Text="Năm"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,10,5"
                           Text="Tháng"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding YearOptions}"
                          SelectedItem="{Binding SelectedYear,
                                                Mode=TwoWay}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding MonthOptions}"
                          SelectedItem="{Binding SelectedMonth,
                                                Mode=TwoWay}" />

                <Button Grid.Row="1"
                        Grid.Column="3"
                        MinHeight="32"
                        Padding="12,6"
                        Content="Làm mới"
                        Command="{Binding RefreshCommand}" />

            </Grid>

        </Border>

        <!-- PERIOD SUMMARY -->
        <Border Grid.Row="1"
        Style="{DynamicResource CardBorderStyle}"
        Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Bảng công tháng"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,5,20,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="Theo dõi kết quả chấm công theo tháng. Kỳ đang mở dùng dữ liệu trực tiếp; kỳ đã đóng dùng bản chụp bất biến." />

                </StackPanel>

                <StackPanel Grid.Column="1"
                    Margin="16,0,0,0">

                    <TextBlock Text="Trạng thái"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding PeriodStatusText}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="2"
                    Margin="16,0,0,0">

                    <TextBlock Text="Nguồn dữ liệu"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding DataSourceText}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="3"
                    Margin="16,0,0,0">

                    <TextBlock Text="Nhân viên"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding EmployeeCount}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="4"
                    Margin="16,0,0,0">

                    <TextBlock Text="Ngày hoàn tất"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding FinalizedDayCount}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="5"
                    Margin="16,0,0,0">

                    <TextBlock Text="Ngày chờ xử lý"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding PendingDayCount}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="6"
                    Margin="16,0,0,0">

                    <TextBlock Text="Ngày điều chỉnh"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding CorrectedDayCount}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- PERIOD CLOSING -->
        <Border Grid.Row="2"
        Style="{DynamicResource CardBorderStyle}"
        Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Đóng kỳ công"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,5,20,0"
                       Text="{Binding ClosingReadinessText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="1"
                    Margin="20,0,0,0">

                    <TextBlock Text="Thời điểm đóng"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding ClosedAtText}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="2"
                    Margin="20,0,0,0">

                    <TextBlock Text="Người đóng"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                       Text="{Binding ClosedByText}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <Button Grid.Column="3"
                        Margin="20,0,0,0"
                        MinHeight="36"
                        Padding="14,7"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Content="Đóng kỳ công"
                        Command="{Binding ClosePeriodCommand}"
                        ToolTip="{Binding ClosingReadinessText}" />

            </Grid>

        </Border>
        <!-- MESSAGE -->
        <StackPanel Grid.Row="3"
                    Margin="0,0,0,10">

            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       FontWeight="SemiBold" />

            <TextBlock Text="Đang tải bảng công..."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontStyle="Italic">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsLoading}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

        <!-- TIMESHEET -->
        <Border Grid.Row="4"
                Style="{DynamicResource CardBorderStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,0,12"
                           Text="Chi tiết ngày công"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Mã NV"
                        Width="100"
                        Binding="{Binding EmployeeCode}" />

                        <DataGridTextColumn Header="Họ tên"
                                            Width="2*"
                                            MinWidth="200"
                                            Binding="{Binding EmployeeFullName}" />

                        <DataGridTextColumn Header="Ngày"
                        Width="105"
                        Binding="{Binding WorkDateText}" />

                        <DataGridCheckBoxColumn Header="Ngày làm việc"
                            Width="100"
                            Binding="{Binding IsWorkingDay}" />

                        <DataGridTextColumn Header="Trạng thái"
                                            Width="*"
                                            MinWidth="150"
                                            Binding="{Binding StatusText}" />

                        <DataGridTextColumn Header="Phút KH"
                        Width="85"
                        Binding="{Binding ExpectedPlannedMinutes}" />

                        <DataGridTextColumn Header="Phút làm"
                        Width="85"
                        Binding="{Binding WorkedMinutes}" />

                        <DataGridTextColumn Header="Đi muộn"
                        Width="85"
                        Binding="{Binding LateMinutes}" />

                        <DataGridTextColumn Header="Về sớm"
                        Width="85"
                        Binding="{Binding EarlyLeaveMinutes}" />

                        <DataGridTextColumn Header="Điều chỉnh"
                        Width="90"
                        Binding="{Binding CorrectionText}" />

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
