<Window x:Class="HrManagement.Desktop.Views.OwnerSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập Chủ doanh nghiệp - HR Management"
        Width="540"
        Height="760"
        MinWidth="540"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">

            <Border Width="430"
                    Padding="32"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <StackPanel>

                    <Border Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="12">

                        <TextBlock Text="HR"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White" />

                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               Text="THIẾT LẬP BAN ĐẦU"
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,8,0,26"
                               Text="Tạo tài khoản Chủ doanh nghiệp đầu tiên"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="Tên đăng nhập"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold" />

                    <TextBox x:Name="UsernameTextBox"
                             MinHeight="40"
                             MaxLength="100"
                             Margin="0,0,0,6"
                             VerticalContentAlignment="Center"
                             Text="{Binding Username,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,0,0,18"
                               Text="Tối đa 100 ký tự và không chứa khoảng trắng."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="Tên hiển thị"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold" />

                    <TextBox MinHeight="40"
                             MaxLength="200"
                             Margin="0,0,0,18"
                             VerticalContentAlignment="Center"
                             Text="{Binding DisplayName,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Mật khẩu"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold" />

                    <PasswordBox x:Name="PasswordBox"
                                 MinHeight="40"
                                 MaxLength="128"
                                 Margin="0,0,0,6" />

                    <TextBlock Margin="0,0,0,18"
                               Text="Từ 15 đến 128 ký tự. Không sử dụng mật khẩu phổ biến."
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="Xác nhận mật khẩu"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold" />

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 MinHeight="40"
                                 MaxLength="128"
                                 Margin="0,0,0,12" />

                    <Border MinHeight="48"
                            Margin="0,0,0,12">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SeparationBrush}" />

                    </Border>

                    <Button x:Name="CreateOwnerButton"
                            Height="42"
                            Content="Tạo tài khoản Chủ doanh nghiệp"
                            Click="CreateOwnerButton_Click"
                            IsDefault="True"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderBrush="{DynamicResource PrimaryBrush}" />

                    <TextBlock Margin="0,18,0,0"
                               Text="Tài khoản này có quyền cao nhất trong hệ thống."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

            </Border>

        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,18"
                   Text="HR Management • Initial Setup"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SecondaryTextBrush}" />

    </Grid>

</Window>
