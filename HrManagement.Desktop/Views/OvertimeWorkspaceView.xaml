<UserControl x:Class="HrManagement.Desktop.Views.OvertimeWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OvertimeWorkspaceView_Loaded">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILTER -->
        <Border Grid.Row="0"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,5"
                           Text="Năm"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,10,5"
                           Text="Tháng"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="0,0,10,5"
                           Text="Nhân viên"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Margin="0,0,10,5"
                           Text="Trạng thái"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding YearOptions}"
                          SelectedItem="{Binding SelectedYear,
                                                Mode=TwoWay}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding MonthOptions}"
                          SelectedItem="{Binding SelectedMonth,
                                                Mode=TwoWay}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="2"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding EmployeeOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedEmployeeOption,
                                                Mode=TwoWay}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="3"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding StatusOptions}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedStatusOption,
                                                Mode=TwoWay}" />

                <Button Grid.Row="1"
                        Grid.Column="4"
                        MinHeight="32"
                        Padding="12,6"
                        Content="Làm mới"
                        Command="{Binding RefreshCommand}" />

            </Grid>

        </Border>

        <!-- SUMMARY -->
        <Border Grid.Row="1"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="Quản lý tăng ca"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,5,20,0"
                               TextWrapping="Wrap"
                               Text="Theo dõi yêu cầu tăng ca, trạng thái duyệt và số phút đã được phê duyệt."
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0">

                    <TextBlock Text="Tổng yêu cầu"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding RequestCount}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="2"
                            Margin="16,0,0,0">

                    <TextBlock Text="Chờ duyệt"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding PendingCount}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="3"
                            Margin="16,0,0,0">

                    <TextBlock Text="Đã duyệt"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding ApprovedCount}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="4"
                            Margin="16,0,0,0">

                    <TextBlock Text="Từ chối"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding RejectedCount}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="5"
                            Margin="16,0,0,0">

                    <TextBlock Text="Đã hủy"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding CancelledCount}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Column="6"
                            Margin="16,0,0,0">

                    <TextBlock Text="Phút đã duyệt"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding TotalApprovedMinutes}"
                               FontWeight="SemiBold"
                               FontSize="17"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- MESSAGE -->
        <StackPanel Grid.Row="2"
                    Margin="0,0,0,10">

            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       FontWeight="SemiBold" />

            <TextBlock Text="Đang tải dữ liệu tăng ca..."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontStyle="Italic">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">

                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsLoading}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </StackPanel>

        <!-- WORKSPACE -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- REQUEST LIST -->
            <Border Grid.Column="0"
                    Style="{DynamicResource CardBorderStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,0,0,12"
                               Text="Danh sách yêu cầu"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow,
                                                    Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã NV"
                                                Width="90"
                                                Binding="{Binding EmployeeCode}" />

                            <DataGridTextColumn Header="Họ tên"
                                                Width="1.5*"
                                                MinWidth="160"
                                                Binding="{Binding EmployeeName}" />

                            <DataGridTextColumn Header="Ngày"
                                                Width="100"
                                                Binding="{Binding WorkDateText}" />

                            <DataGridTextColumn Header="Yêu cầu"
                                                Width="85"
                                                Binding="{Binding RequestedMinutes}" />

                            <DataGridTextColumn Header="Đã duyệt"
                                                Width="85"
                                                Binding="{Binding ApprovedMinutesText}" />

                            <DataGridTextColumn Header="Trạng thái"
                                                Width="110"
                                                Binding="{Binding StatusText}" />

                            <DataGridTextColumn Header="Lý do"
                                                Width="2*"
                                                MinWidth="160"
                                                Binding="{Binding ReasonText}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- HISTORY -->
            <Border Grid.Column="2"
                    Style="{DynamicResource CardBorderStyle}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Lịch sử xử lý"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                            <TextBlock Margin="0,4,10,0"
                                       Text="Chọn một yêu cầu để xem lịch sử."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                        </StackPanel>

                        <Button Grid.Column="1"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Content="Làm mới"
                                Command="{Binding RefreshHistoryCommand}" />

                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,8">

                        <TextBlock Text="{Binding HistoryErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Đang tải lịch sử..."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontStyle="Italic">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility"
                                            Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsHistoryLoading}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding HistoryRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Thời điểm"
                                                Width="135"
                                                Binding="{Binding ChangedAtText}" />

                            <DataGridTextColumn Header="Từ"
                                                Width="95"
                                                Binding="{Binding PreviousStatusText}" />

                            <DataGridTextColumn Header="Sang"
                                                Width="95"
                                                Binding="{Binding NewStatusText}" />

                            <DataGridTextColumn Header="Phút"
                                                Width="65"
                                                Binding="{Binding ApprovedMinutesText}" />

                            <DataGridTextColumn Header="Người xử lý"
                                                Width="110"
                                                Binding="{Binding ChangedByUsername}" />

                            <DataGridTextColumn Header="Ghi chú"
                                                Width="2*"
                                                MinWidth="130"
                                                Binding="{Binding NoteText}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
