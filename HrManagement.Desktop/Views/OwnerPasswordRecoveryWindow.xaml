<Window x:Class="HrManagement.Desktop.Views.OwnerPasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khôi phục tài khoản Owner - HR Management"
        Width="580"
        MinWidth="580"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},
                            Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Border Margin="24"
                    Padding="30"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">

                <Grid>

                    <!-- STEP 1 -->
                    <StackPanel>

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Visible" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecoveryCompleted}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Khôi phục mật khẩu Owner"
                                   FontSize="22"
                                   FontWeight="SemiBold" />

                        <TextBlock Margin="0,7,0,24"
                                   Text="Nhập tên đăng nhập Owner, mã khôi phục và mật khẩu mới."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Text="Tên đăng nhập Owner"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <TextBox x:Name="UsernameTextBox"
                                 MinHeight="40"
                                 MaxLength="100"
                                 Margin="0,0,0,18"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Username,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Mã khôi phục"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="RecoveryCodeBox"
                                     MinHeight="40"
                                     Margin="0,0,0,18" />

                        <TextBlock Text="Mật khẩu mới"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="NewPasswordBox"
                                     MinHeight="40"
                                     MaxLength="128"
                                     Margin="0,0,0,6" />

                        <TextBlock Margin="0,0,0,18"
                                   Text="Từ 15 đến 128 ký tự. Không sử dụng mật khẩu phổ biến."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Text="Xác nhận mật khẩu mới"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     MinHeight="40"
                                     MaxLength="128"
                                     Margin="0,0,0,12" />

                        <Border MinHeight="50"
                                Margin="0,0,0,12">

                            <TextBlock Text="{Binding ErrorMessage}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}" />

                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button Content="Hủy"
                                    Width="90"
                                    Margin="0,0,8,0"
                                    IsCancel="True" />

                            <Button Content="Khôi phục tài khoản"
                                    Width="160"
                                    MinHeight="40"
                                    IsDefault="True"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="RecoverButton_Click"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold" />

                        </StackPanel>

                    </StackPanel>

                    <!-- STEP 2 -->
                    <StackPanel>

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecoveryCompleted}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Mật khẩu đã được đặt lại"
                                   FontSize="22"
                                   FontWeight="SemiBold" />

                        <TextBlock Margin="0,8,0,22"
                                   Text="Mã khôi phục cũ đã hết hiệu lực. Hãy lưu mã mới bên dưới trước khi quay lại màn đăng nhập."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Text="Recovery Code mới"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <TextBox x:Name="NewRecoveryCodeTextBox"
                                 MinHeight="78"
                                 Padding="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewRecoveryCode,
                                                Mode=OneWay}" />

                        <TextBlock Margin="0,12,0,22"
                                   Text="Mã này sẽ không được hiển thị lại sau khi đóng cửa sổ."
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />

                        <Button Content="Tôi đã lưu mã mới"
                                Width="160"
                                MinHeight="40"
                                HorizontalAlignment="Right"
                                IsDefault="True"
                                Command="{Binding ConfirmRecoveryCodeSavedCommand}"
                                Background="{DynamicResource PrimaryBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                Foreground="White"
                                FontWeight="SemiBold" />

                    </StackPanel>

                </Grid>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>
