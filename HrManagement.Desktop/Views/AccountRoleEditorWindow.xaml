<Window x:Class="HrManagement.Desktop.Views.AccountRoleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gán vai trò - HR Management"
        Width="700"
        Height="650"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="22"
                Margin="0,0,0,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>

                <TextBlock Text="Gán vai trò cho tài khoản"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding DisplayName,
                                          Mode=OneWay}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <StackPanel Margin="0,5,0,0"
                            Orientation="Horizontal">

                    <TextBlock Text="Tên đăng nhập: "
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding Username,
                                              Mode=OneWay}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="20,0,0,0"
                               Text="Trạng thái: "
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Text="{Binding AccountStatusText,
                                              Mode=OneWay}"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <TextBlock Margin="0,8,0,0"
                           Text="Chọn các vai trò được gán cho tài khoản Standard này. Vai trò ngừng sử dụng vẫn được giữ/gán nhưng không cấp quyền cho đến khi được kích hoạt lại."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

        </Border>

        <!-- Roles -->
        <Border Grid.Row="1"
                Padding="12"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Roles}"
                              IsEnabled="{Binding CanSubmit,
                                                  Mode=OneWay}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="10,9"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">

                                <CheckBox IsChecked="{Binding IsSelected,
                                                             Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center">

                                    <Grid Margin="8,0,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock Text="{Binding Name,
                                                                      Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                                            <TextBlock Margin="0,3,12,0"
                                                       Text="{Binding Description,
                                                                      Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />

                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Margin="20,0,0,0"
                                                   Text="{Binding StatusText,
                                                                  Mode=OneWay}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                    </Grid>

                                </CheckBox>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Border>

        <!-- Error -->
        <Border Grid.Row="2"
                MinHeight="48"
                Margin="0,12,0,8">

            <TextBlock Text="{Binding ErrorMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" />

        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <TextBlock Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text="Bỏ chọn tất cả sẽ gỡ toàn bộ vai trò."
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

            <Button Content="Hủy"
                    Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True" />

            <Button Content="Lưu vai trò"
                    Width="130"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSubmit,
                                        Mode=OneWay}"
                    IsDefault="True"
                    Background="{DynamicResource PrimaryBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    Foreground="White"
                    FontWeight="SemiBold" />

        </StackPanel>

    </Grid>

</Window>
