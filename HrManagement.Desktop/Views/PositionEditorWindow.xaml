<Window x:Class="HrManagement.Desktop.Views.PositionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="460"
        Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBlock Margin="0,7,0,0"
                       Text="Thông tin chức danh được dùng làm dữ liệu danh mục trong hệ thống."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,24,0,0">

            <TextBlock Text="Mã chức danh"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBox Margin="0,6,0,16"
                     Text="{Binding Code,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="32" />

            <TextBlock Text="Tên chức danh"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />

            <TextBox Margin="0,6,0,0"
                     Text="{Binding Name,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="200" />

            <TextBlock Margin="0,14,0,0"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" />

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Width="90"
                    Margin="0,0,10,0"
                    Content="Hủy"
                    IsCancel="True" Height="36" />

            <Button Width="100"
                    Content="Lưu"
                    Command="{Binding ConfirmCommand}" />

        </StackPanel>

    </Grid>

</Window>
