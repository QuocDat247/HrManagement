<UserControl x:Class="HrManagement.Desktop.Views.AccountManagementWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="AccountManagementWorkspaceView_Loaded">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Tài khoản &amp; Phân quyền"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,6,0,0"
                           Text="Quản lý tài khoản đăng nhập, vai trò và phạm vi truy cập hệ thống."
                           Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="Tạo tài khoản"
                        Command="{Binding CreateAccountCommand}"
                        Padding="16,7"
                        Margin="0,0,8,0" />

                <Button Content="Sửa tài khoản"
                        Command="{Binding EditAccountCommand}"
                        Padding="16,7"
                        Margin="0,0,8,0" />

                <Button Content="Vô hiệu hóa"
                        Command="{Binding DeactivateAccountCommand}"
                        Padding="16,7"
                        Margin="0,0,8,0" />

                <Button Content="Kích hoạt lại"
                        Command="{Binding ReactivateAccountCommand}"
                        Padding="16,7"
                        Margin="0,0,8,0" />
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Padding="16,7" />

            </StackPanel>

        </Grid>

        <!-- Summary -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,18,0,14">

            <Border Padding="12,7"
                    Margin="0,0,8,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Tài khoản: " />
                    <Run Text="{Binding AccountRows.Count, Mode=OneWay}" />
                </TextBlock>

            </Border>

            <Border Padding="12,7"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">

                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="Vai trò: " />
                    <Run Text="{Binding Roles.Count, Mode=OneWay}" />
                </TextBlock>

            </Border>

        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Accounts -->
            <Border Grid.Column="0"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">

                        <TextBlock Text="Tài khoản"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,4,0,0"
                                   Text="Các tài khoản có thể đăng nhập vào hệ thống."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AccountRows}"
                              SelectedItem="{Binding SelectedAccountRow,
                                                   Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tên đăng nhập"
                                                Width="150"
                                                Binding="{Binding Username, Mode=OneWay}" />

                            <DataGridTextColumn Header="Tên hiển thị"
                                                Width="180"
                                                Binding="{Binding DisplayName, Mode=OneWay}" />

                            <DataGridTextColumn Header="Loại"
                                                Width="90"
                                                Binding="{Binding KindText, Mode=OneWay}" />

                            <DataGridTextColumn Header="Nhân viên"
                                                Width="220"
                                                Binding="{Binding EmployeeText, Mode=OneWay}" />

                            <DataGridTextColumn Header="Vai trò"
                                                Width="*"
                                                Binding="{Binding RolesText, Mode=OneWay}" />

                            <DataGridTextColumn Header="Trạng thái"
                                                Width="130"
                                                Binding="{Binding StatusText, Mode=OneWay}" />

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- Roles -->
            <Border Grid.Column="2"
                    Padding="16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">

                        <TextBlock Text="Vai trò"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,4,0,0"
                                   Text="Vai trò dùng để cấp quyền cho tài khoản Standard."
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole,
                                                   Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tên vai trò"
                                                Width="170"
                                                Binding="{Binding Name, Mode=OneWay}" />

                            <DataGridTextColumn Header="Mô tả"
                                                Width="*"
                                                Binding="{Binding Description, Mode=OneWay}" />

                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="125">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock>

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                            Value="Ngừng sử dụng" />

                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource SecondaryTextBrush}" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="True">

                                                            <Setter Property="Text"
                                                                    Value="Đang sử dụng" />

                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource PrimaryTextBrush}" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <!-- Loading overlay -->
            <Border Grid.ColumnSpan="3"
                    Background="{DynamicResource PageBackgroundBrush}"
                    Opacity="0.88">

                <Border.Style>

                    <Style TargetType="Border">

                        <Setter Property="Visibility"
                                Value="Collapsed" />

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsLoading}"
                                         Value="True">

                                <Setter Property="Visibility"
                                        Value="Visible" />

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Border.Style>

                <TextBlock Text="Đang tải dữ liệu tài khoản và phân quyền..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

            </Border>

        </Grid>

        <!-- Error -->
        <TextBlock Grid.Row="3"
                   Margin="0,10,0,0"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" />

    </Grid>

</UserControl>
