<Window x:Class="HrManagement.Desktop.Views.EditAccountProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa tài khoản - HR Management"
        Width="560"
        MinWidth="560"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea},
                            Path=Height}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True"
                  PanningMode="VerticalOnly">

            <Border Margin="24"
                Padding="28"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>

                <TextBlock Text="Sửa tài khoản"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,6,0,24"
                           Text="Cập nhật tên hiển thị và liên kết nhân viên. Tên đăng nhập và loại tài khoản không thể thay đổi."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="Tên đăng nhập"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox MinHeight="40"
                         Margin="0,0,0,18"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding Username,
                                        Mode=OneWay}" />

                <TextBlock Text="Loại tài khoản"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox MinHeight="40"
                         Margin="0,0,0,18"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding KindText,
                                        Mode=OneWay}" />

                <TextBlock Text="Tên hiển thị"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox x:Name="DisplayNameTextBox"
                         MinHeight="40"
                         MaxLength="200"
                         Margin="0,0,0,18"
                         VerticalContentAlignment="Center"
                         Text="{Binding DisplayName,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Liên kết nhân viên"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <ComboBox MinHeight="40"
                          Margin="0,0,0,18"
                          ItemsSource="{Binding EmployeeOptions}"
                          SelectedItem="{Binding SelectedEmployeeOption,
                                               Mode=TwoWay}"
                          DisplayMemberPath="DisplayText" />

                <Border Margin="0,4,0,18"
                        Padding="16"
                        Background="{DynamicResource PageBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordResetAvailable}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="Đặt lại mật khẩu"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="0,6,0,14"
                                   Text="Tạo mật khẩu tạm mới. Người dùng sẽ bắt buộc đổi mật khẩu ở lần đăng nhập tiếp theo."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <TextBlock Text="Mật khẩu tạm mới"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="ResetPasswordBox"
                                     MinHeight="40"
                                     MaxLength="128"
                                     Margin="0,0,0,12"
                                     IsEnabled="{Binding CanResetPasswordSubmit}" />

                        <TextBlock Text="Xác nhận mật khẩu tạm"
                                   Margin="0,0,0,7"
                                   FontWeight="SemiBold" />

                        <PasswordBox x:Name="ResetPasswordConfirmBox"
                                     MinHeight="40"
                                     MaxLength="128"
                                     Margin="0,0,0,12"
                                     IsEnabled="{Binding CanResetPasswordSubmit}" />

                        <Button x:Name="ResetPasswordButton"
                                Content="Đặt lại mật khẩu"
                                Width="150"
                                MinHeight="38"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanResetPasswordSubmit}"
                                Click="ResetPasswordButton_Click" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,0,0,8"
                           Text="{Binding SuccessMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryBrush}" />

                <Border MinHeight="52"
                        Margin="0,0,0,12">

                    <TextBlock Text="{Binding ErrorMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />

                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Hủy"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True" />

                    <Button Content="Lưu thay đổi"
                            Width="130"
                            IsDefault="True"
                            IsEnabled="{Binding CanSubmit}"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold" />

                </StackPanel>

            </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Window>
