<Window x:Class="HrManagement.Desktop.Views.EditAccountProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa tài khoản - HR Management"
        Width="560"
        Height="674"
        MinWidth="560"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PageBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid>

        <Border Margin="24"
                Padding="28"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <StackPanel>

                <TextBlock Text="Sửa tài khoản"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Margin="0,6,0,24"
                           Text="Cập nhật tên hiển thị và liên kết nhân viên. Tên đăng nhập và loại tài khoản không thể thay đổi."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="Tên đăng nhập"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox MinHeight="40"
                         Margin="0,0,0,18"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding Username,
                                        Mode=OneWay}" />

                <TextBlock Text="Loại tài khoản"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox MinHeight="40"
                         Margin="0,0,0,18"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         Text="{Binding KindText,
                                        Mode=OneWay}" />

                <TextBlock Text="Tên hiển thị"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <TextBox x:Name="DisplayNameTextBox"
                         MinHeight="40"
                         MaxLength="200"
                         Margin="0,0,0,18"
                         VerticalContentAlignment="Center"
                         Text="{Binding DisplayName,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Liên kết nhân viên"
                           Margin="0,0,0,7"
                           FontWeight="SemiBold" />

                <ComboBox MinHeight="40"
                          Margin="0,0,0,18"
                          ItemsSource="{Binding EmployeeOptions}"
                          SelectedItem="{Binding SelectedEmployeeOption,
                                               Mode=TwoWay}"
                          DisplayMemberPath="DisplayText" />

                <Border MinHeight="52"
                        Margin="0,0,0,12">

                    <TextBlock Text="{Binding ErrorMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource WarningBrush}" />

                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Hủy"
                            Width="90"
                            Margin="0,0,8,0"
                            IsCancel="True" />

                    <Button Content="Lưu thay đổi"
                            Width="130"
                            IsDefault="True"
                            IsEnabled="{Binding CanSubmit}"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource PrimaryBrush}"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            FontWeight="SemiBold" />

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>
