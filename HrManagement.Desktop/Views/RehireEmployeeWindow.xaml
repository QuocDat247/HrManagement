<Window x:Class="HrManagement.Desktop.Views.RehireEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tái tuyển dụng"
        Width="480"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Tái tuyển dụng"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <TextBlock Margin="0,8,0,0"
                       Text="Tạo một giai đoạn làm việc mới cho nhân viên đã nghỉ việc."
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,22,0,0">

            <TextBlock Text="Mã nhân viên"
                       FontWeight="SemiBold" />

            <TextBlock Text="{Binding EmployeeCode}"
                       Margin="0,4,0,14" />

            <TextBlock Text="Họ tên"
                       FontWeight="SemiBold" />

            <TextBlock Text="{Binding FullName}"
                       Margin="0,4,0,14" />

            <TextBlock Text="Ngày nghỉ gần nhất"
                       FontWeight="SemiBold" />

            <TextBlock Text="{Binding TerminationDate,
                                     StringFormat={}{0:dd/MM/yyyy}}"
                       Margin="0,4,0,14" />

            <TextBlock Text="Ngày tái tuyển dụng"
                       FontWeight="SemiBold" />

            <DatePicker SelectedDate="{Binding RehireDate,
                                              Mode=TwoWay,
                                              UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,6,0,14" />

            <TextBlock Text="Trạng thái sau tái tuyển dụng"
                       FontWeight="SemiBold" />

            <ComboBox Margin="0,6,0,0"
                      ItemsSource="{Binding StatusOptions}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedStatusOption,
                                             Mode=TwoWay}" />

            <TextBlock Margin="0,16,0,0"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap"
                       Text="ℹ Lịch sử nghỉ việc trước đó sẽ được giữ nguyên. Hệ thống sẽ tạo một giai đoạn làm việc mới." />

            <TextBlock Text="{Binding ErrorMessage}"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource WarningBrush}"
                       TextWrapping="Wrap" />

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Width="90"
                    Margin="0,0,10,0"
                    Content="Hủy"
                    IsCancel="True" />

            <Button Width="110"
                    Content="Tái tuyển"
                    Command="{Binding ConfirmCommand}" />

        </StackPanel>

    </Grid>

</Window>
