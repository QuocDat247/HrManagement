<UserControl x:Class="HrManagement.Desktop.Views.PayrollWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="PayrollWorkspaceView_Loaded">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- FILTER + PERIOD STATUS -->
        <Border Grid.Row="0"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,5"
                           Text="Năm"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Margin="0,0,10,5"
                           Text="Tháng"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="0,0,10,5"
                           Text="Trạng thái kỳ lương"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding YearOptions}"
                          SelectedItem="{Binding SelectedYear,
                                                Mode=TwoWay}" />

                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,10,0"
                          MinHeight="32"
                          ItemsSource="{Binding MonthOptions}"
                          SelectedItem="{Binding SelectedMonth,
                                                Mode=TwoWay}" />

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        Padding="12,6"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="{Binding ModeText}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />

                        <TextBlock Margin="12,0,0,0"
                                   Text="{Binding ClosedInfoText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                    </StackPanel>

                </Border>

                <Button Grid.Row="1"
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        MinHeight="32"
                        Padding="12,6"
                        Content="Làm mới"
                        Command="{Binding RefreshCommand}" />

                <Button Grid.Row="1"
                        Grid.Column="4"
                        MinHeight="32"
                        Padding="12,6"
                        Content="Đóng kỳ lương"
                        Command="{Binding ClosePayrollCommand}"
                        IsEnabled="{Binding CanClose}"
                        ToolTip="Chỉ có thể đóng khi bản xem trước đã đủ điều kiện." />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           Margin="0,10,0,0"
                           Text="{Binding ErrorMessage}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           Margin="0,10,0,0"
                           Text="{Binding SuccessMessage}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

            </Grid>

        </Border>

        <!-- SUMMARY -->
        <Border Grid.Row="1"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="Bảng lương"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="Xem trước bảng lương từ kỳ công đã đóng hoặc tra cứu snapshot bất biến của kỳ lương đã chốt."
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <StackPanel Grid.Row="0"
                            Grid.Column="1">

                    <TextBlock Text="Nhân viên"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="{Binding EmployeeCount}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

                <!-- CURRENCY SUMMARIES -->
                <ItemsControl Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="0,18,0,0"
                              ItemsSource="{Binding CurrencySummaries}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="0,0,12,8"
                                    Padding="14"
                                    MinWidth="240"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding CurrencyCode}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding EmployeeCount,
                                                              StringFormat='{}{0} NV'}"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,8,15,0"
                                               Text="Lương cơ bản"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,8,0,0"
                                               Text="{Binding BaseSalaryAmount,
                                                              StringFormat={}{0:N2}}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Margin="0,6,15,0"
                                               Text="Tăng ca"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Margin="0,6,0,0"
                                               Text="{Binding OvertimeAmount,
                                                              StringFormat={}{0:N2}}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Margin="0,6,15,0"
                                               Text="Tổng gross"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Margin="0,6,0,0"
                                               Text="{Binding GrossAmount,
                                                              StringFormat={}{0:N2}}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Grid>

        </Border>

        <!-- ISSUES -->
        <Border Grid.Row="2"
                Style="{DynamicResource CardBorderStyle}"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="Kiểm tra kỳ lương"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,5,0,0"
                               Text="Các vấn đề cần xử lý trước khi đóng."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding IssueMessages}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Margin="0,2"
                                       Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Grid>

        </Border>

        <!-- EMPLOYEE PAYROLL TABLE -->
        <Border Grid.Row="3"
                Style="{DynamicResource CardBorderStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Chi tiết nhân viên"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />

                    <TextBlock Margin="0,4,0,0"
                               Text="Kỳ đã đóng hiển thị dữ liệu snapshot; kỳ chưa đóng hiển thị bản tính xem trước."
                               Foreground="{DynamicResource SecondaryTextBrush}" />

                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MinHeight="240">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Mã NV"
                                            Binding="{Binding EmployeeCode}"
                                            Width="90" />

                        <DataGridTextColumn Header="Họ tên"
                                            Binding="{Binding EmployeeFullName}"
                                            Width="1.6*" />

                        <DataGridTextColumn Header="Tiền tệ"
                                            Binding="{Binding CurrencyCode}"
                                            Width="75" />

                        <DataGridTextColumn Header="Lương cơ bản"
                                            Binding="{Binding BaseSalaryAmount,
                                                              StringFormat={}{0:N2}}"
                                            Width="120" />

                        <DataGridTextColumn Header="OT duyệt"
                                            Binding="{Binding ApprovedOvertimeMinutes}"
                                            Width="85" />

                        <DataGridTextColumn Header="OT trả"
                                            Binding="{Binding PayableOvertimeMinutes}"
                                            Width="80" />

                        <DataGridTextColumn Header="Tiền OT"
                                            Binding="{Binding OvertimeAmount,
                                                              StringFormat={}{0:N2}}"
                                            Width="105" />

                        <DataGridTextColumn Header="Gross"
                                            Binding="{Binding GrossAmount,
                                                              StringFormat={}{0:N2}}"
                                            Width="120" />

                        <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding StatusText}"
                                            Width="95" />

                        <DataGridTextColumn Header="Cần xử lý"
                                            Binding="{Binding IssuesText}"
                                            Width="1.8*">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping"
                                            Value="Wrap" />
                                    <Setter Property="VerticalAlignment"
                                            Value="Center" />
                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</UserControl>
