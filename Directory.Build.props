<Project>

  <PropertyGroup>

    <HrCustomerProfile
      Condition="'$(HrCustomerProfile)' == ''">Generic</HrCustomerProfile>

    <HrCustomerProfilePath>
      $(MSBuildThisFileDirectory)build\customer-profiles\$(HrCustomerProfile).props
    </HrCustomerProfilePath>

  </PropertyGroup>

  <Import Project="$(HrCustomerProfilePath)"
          Condition="Exists('$(HrCustomerProfilePath)')" />

  <PropertyGroup>

    <Version>1.0.0-dev.1</Version>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>dev.1</VersionSuffix>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-dev.1</InformationalVersion>

    <HrProductEdition
      Condition="'$(HrProductEdition)' == ''">Standard</HrProductEdition>

    <HrCustomerCode
      Condition="'$(HrCustomerCode)' == ''">Generic</HrCustomerCode>

    <HrReleaseChannel
      Condition="'$(HrReleaseChannel)' == ''">Development</HrReleaseChannel>

    <HrFeatureEmployees
      Condition="'$(HrFeatureEmployees)' == ''">true</HrFeatureEmployees>

    <HrFeatureOrganization
      Condition="'$(HrFeatureOrganization)' == ''">true</HrFeatureOrganization>

    <HrFeatureTimeManagement
      Condition="'$(HrFeatureTimeManagement)' == ''">true</HrFeatureTimeManagement>

    <HrFeaturePayroll
      Condition="'$(HrFeaturePayroll)' == ''">true</HrFeaturePayroll>

  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

</PropertyGroup>

  <Target Name="ValidateHrCustomerProfile"
        BeforeTargets="PrepareForBuild">

    <Error Condition="!Exists('$(HrCustomerProfilePath)')"
           Text="HR customer profile '$(HrCustomerProfile)' was not found at '$(HrCustomerProfilePath)'." />

  </Target>

</Project>
