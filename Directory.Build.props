<Project>

  <PropertyGroup>

    <Version>1.0.0-dev.1</Version>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>dev.1</VersionSuffix>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-dev.1</InformationalVersion>

    <HrProductEdition
      Condition="'$(HrProductEdition)' == ''">Standard</HrProductEdition>

    <HrCustomerCode
      Condition="'$(HrCustomerCode)' == ''">Generic</HrCustomerCode>

    <HrReleaseChannel
      Condition="'$(HrReleaseChannel)' == ''">Development</HrReleaseChannel>

  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

</PropertyGroup>

</Project>
